{
    "compilerOptions": {
        "target": "esnext",
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "paths": {
            "@taraxvoid/voidflow/cloudflare": ["./cloudflare/tokens.ts"],
            "@taraxvoid/voidflow/config": ["./config/index.ts"],
            "@taraxvoid/voidflow/rulesets": ["./rulesets/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.mts"],
    "exclude": ["node_modules", "dist", "templates/common/voidflow.config.ts"]
}
