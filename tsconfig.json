{
    "compilerOptions": {
        "target": "esnext",
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["bun"]
    },
    "include": ["**/*.ts", "**/*.mts"],
    "exclude": ["node_modules", "dist"]
}
