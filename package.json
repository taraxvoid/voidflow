{
    "name": "@taraxvoid/voidflow",
    "version": "1.0.0-next.1",
    "description": "Reusable GitHub Actions CI/CD for TypeScript sites and tools: supply-chain and security gates, accessibility and performance budgets, Cloudflare and Netlify deploys.",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "github-actions",
        "ci",
        "reusable-workflows",
        "lefthook",
        "renovate",
        "bun",
        "playwright",
        "unlighthouse",
        "cloudflare"
    ],
    "homepage": "https://github.com/taraxvoid/voidflow#readme",
    "bugs": {
        "url": "https://github.com/taraxvoid/voidflow/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/taraxvoid/voidflow.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "bin": {
        "voidflow": "dist/scripts/cli.js",
        "unlighthouse-runner": "scripts/unlighthouse/run.ts",
        "check-licenses": "scripts/check-licenses.ts"
    },
    "exports": {
        "./playwright": {
            "types": "./playwright/index.d.mts",
            "default": "./playwright/index.mjs"
        },
        "./biome": "./biome/base.json",
        "./cloudflare": {
            "types": "./cloudflare/tokens.ts",
            "bun": "./cloudflare/tokens.ts",
            "default": "./dist/cloudflare/tokens.js"
        },
        "./rulesets": {
            "types": "./rulesets/index.ts",
            "bun": "./rulesets/index.ts",
            "default": "./dist/rulesets/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "biome",
        "playwright",
        "scripts/unlighthouse",
        "scripts/check-licenses.ts",
        "dist",
        "cloudflare",
        "rulesets"
    ],
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=24"
    },
    "scripts": {
        "build": "bun build ./scripts/cli.ts ./cloudflare/tokens.ts ./rulesets/index.ts --outdir=dist --root=. --target=node --format=esm --splitting --packages=external",
        "prepack": "rm -rf dist && bun run build",
        "prepare": "lefthook install || echo 'lefthook not installed (run mise install); git hooks skipped'",
        "test": "bun test"
    },
    "peerDependencies": {
        "@playwright/test": ">=1.40"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@playwright/test": "1.64.1",
        "@socketsecurity/bun-security-scanner": "1.1.3"
    },
    "dependencies": {
        "license-checker-rseidelsohn": "5.0.1"
    }
}
