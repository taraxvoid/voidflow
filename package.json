{
    "name": "@taraxvoid/voidflow",
    "version": "0.17.0-next.2",
    "description": "Enter a flow state of security, stability, and developer ergonomics - batteries-included Biome, vitest, Astro, local hooks, CI and deployments on Netlify and Cloudflare support with GitHub rulesets, branch environments, releases and security checks.",
    "license": "MIT",
    "keywords": [
        "github-actions",
        "ci",
        "reusable-workflows",
        "lefthook",
        "renovate",
        "bun",
        "playwright",
        "unlighthouse",
        "cloudflare"
    ],
    "homepage": "https://github.com/taraxvoid/voidflow#readme",
    "bugs": {
        "url": "https://github.com/taraxvoid/voidflow/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/taraxvoid/voidflow.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "bin": {
        "voidflow": "scripts/cli.ts",
        "unlighthouse-runner": "scripts/unlighthouse/run.ts",
        "check-licenses": "scripts/check-licenses.ts"
    },
    "exports": {
        "./playwright": {
            "types": "./playwright/index.d.mts",
            "default": "./playwright/index.mjs"
        },
        "./biome": "./biome/base.json",
        "./cloudflare": "./cloudflare/tokens.ts",
        "./rulesets": "./rulesets/index.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "biome",
        "playwright",
        "scripts/unlighthouse",
        "scripts/check-licenses.ts",
        "scripts/cli.ts",
        "scripts/cf-tokens.ts",
        "scripts/apply-rulesets.ts",
        "scripts/lib",
        "cloudflare",
        "rulesets"
    ],
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=22"
    },
    "scripts": {
        "prepare": "lefthook install || echo 'lefthook not installed (run mise install); git hooks skipped'",
        "test": "bun test"
    },
    "peerDependencies": {
        "@playwright/test": ">=1.40"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@playwright/test": "1.64.1",
        "@socketsecurity/bun-security-scanner": "1.1.3"
    },
    "dependencies": {
        "license-checker-rseidelsohn": "5.0.1"
    }
}
