{
    "name": "@taraxvoid/voidflow",
    "version": "0.13.0",
    "description": "Shared workflows, hooks and tooling for @taraxvoid repos",
    "license": "MIT",
    "keywords": [
        "github-actions",
        "ci",
        "reusable-workflows",
        "lefthook",
        "renovate",
        "bun",
        "playwright",
        "unlighthouse",
        "cloudflare"
    ],
    "homepage": "https://github.com/taraxvoid/voidflow#readme",
    "bugs": {
        "url": "https://github.com/taraxvoid/voidflow/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/taraxvoid/voidflow.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "bin": {
        "unlighthouse-runner": "scripts/unlighthouse/run.ts",
        "check-licenses": "scripts/check-licenses.ts"
    },
    "exports": {
        "./playwright": {
            "types": "./playwright/index.d.mts",
            "default": "./playwright/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "playwright",
        "scripts/unlighthouse",
        "scripts/check-licenses.ts"
    ],
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=22"
    },
    "scripts": {
        "prepare": "lefthook install || echo 'lefthook not installed (run mise install); git hooks skipped'",
        "test": "bun test"
    },
    "peerDependencies": {
        "@playwright/test": ">=1.40"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "1.64.0",
        "@socketsecurity/bun-security-scanner": "1.1.3"
    },
    "dependencies": {
        "license-checker-rseidelsohn": "5.0.1"
    }
}
