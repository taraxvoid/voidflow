{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Shared Renovate preset for the voidflow fleet. Use: { \"extends\": [\"github>taraxvoid/voidflow\"] }",
    "extends": [
        "config:best-practices",
        "customManagers:githubActionsVersions"
    ],
    "ignorePresets": [":pinDevDependencies", "helpers:pinGitHubActionDigests"],
    "timezone": "America/Chicago",
    "schedule": ["before 9am on monday"],
    "semanticCommits": "enabled",
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps",
    "dependencyDashboard": true,
    "minimumReleaseAge": "3 days",
    "internalChecksFilter": "strict",
    "prConcurrentLimit": 3,
    "rebaseWhen": "conflicted",
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["before 9am on the first day of the month"]
    },
    "vulnerabilityAlerts": {
        "enabled": false
    },
    "packageRules": [
        {
            "description": "One PR for all GitHub Actions bumps",
            "matchManagers": ["github-actions"],
            "groupName": "github actions"
        },
        {
            "description": "shellcheck is actively developed but releases roughly once a year, so the default abandonment check false-positives",
            "matchPackageNames": ["shellcheck", "koalaman/shellcheck"],
            "abandonmentThreshold": "2 years"
        },
        {
            "description": "One PR for minor and patch dev dependency bumps. Listed before the named groups below so astro, biome and playwright keep their own PRs (later rules win)",
            "matchDepTypes": ["devDependencies"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "dev dependencies"
        },
        {
            "matchPackageNames": ["astro", "@astrojs/**"],
            "groupName": "astro"
        },
        {
            "matchPackageNames": ["@biomejs/**"],
            "groupName": "biome"
        },
        {
            "description": "Playwright and its browsers move together",
            "matchPackageNames": [
                "@playwright/test",
                "playwright",
                "playwright-core",
                "@axe-core/playwright"
            ],
            "groupName": "playwright"
        },
        {
            "description": "Our own package (stable releases only, canaries are prereleases Renovate skips) skips the release-age gate and the Monday schedule so callers get the bump PR right after a release. Last so it wins over the grouping rules above (mirrors minimumReleaseAgeExcludes in bunfig.toml)",
            "matchPackageNames": [
                "@taraxvoid/voidflow",
                "voidflow",
                "taraxvoid/voidflow"
            ],
            "minimumReleaseAge": null,
            "schedule": ["at any time"],
            "groupName": "voidflow",
            "prPriority": 10
        }
    ],
    "customManagers": [
        {
            "description": "@taraxvoid/voidflow pinned inside package.json scripts (bunx --package @taraxvoid/voidflow@x.y.z ...)",
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)package\\.json$/"],
            "matchStrings": [
                "--package (?<depName>@taraxvoid/voidflow|voidflow)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
            ],
            "datasourceTemplate": "npm"
        },
        {
            "description": "lefthook remote pinned to a voidflow release tag",
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)lefthook\\.ya?ml$/"],
            "matchStrings": [
                "git_url:\\s*https://github\\.com/(?<depName>taraxvoid/voidflow)\\s+ref:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
            ],
            "datasourceTemplate": "github-tags"
        },
        {
            "description": "Tool versions in a justfile: name_version := \"x.y.z\" with a `# renovate: datasource=... depName=...` comment above",
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)justfile$/"],
            "extractVersionTemplate": "^v?(?<version>.+)$",
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+ := \"(?<currentValue>[^\"]+)\""
            ]
        }
    ]
}
